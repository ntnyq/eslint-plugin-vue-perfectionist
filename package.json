{
  "name": "eslint-plugin-vue-perfectionist",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "description": "ESLint rules for consistent, readable, and maintainable Vue 3 code.",
  "keywords": [
    "composition-api",
    "eslint",
    "eslint-plugin",
    "perfectionist",
    "script-setup",
    "sort",
    "vue",
    "vue-sfc",
    "vue3"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://github.com/ntnyq/eslint-plugin-vue-perfectionist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/eslint-plugin-vue-perfectionist.git"
  },
  "bugs": {
    "url": "https://github.com/ntnyq/eslint-plugin-vue-perfectionist/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs run build",
    "docs:dev": "pnpm -C docs run dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck test",
    "release:version": "bumpp",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.10.0 || ^10.0.0",
    "vue-eslint-parser": "^10.0.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.70.0",
    "natural-orderby": "^5.0.0"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.19",
    "@ntnyq/tsconfig": "^3.1.0",
    "@types/node": "^26.5.1",
    "@typescript-eslint/parser": "^8.70.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-typegen": "^2.3.1",
    "eslint-vitest-rule-tester": "^3.2.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.67.0",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue,md,yml,yaml,json,toml}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
