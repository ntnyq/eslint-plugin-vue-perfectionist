{
  "name": "eslint-plugin-vue-perfectionist",
  "type": "module",
  "version": "0.18.0",
  "packageManager": "pnpm@12.18.0",
  "description": "ESLint rules for consistent, readable, and maintainable Vue 3 code.",
  "keywords": [
    "composition-api",
    "eslint",
    "eslint-plugin",
    "perfectionist",
    "script-setup",
    "sort",
    "vue",
    "vue-sfc",
    "vue3"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://github.com/ntnyq/eslint-plugin-vue-perfectionist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntnyq/eslint-plugin-vue-perfectionist.git"
  },
  "bugs": {
    "url": "https://github.com/ntnyq/eslint-plugin-vue-perfectionist/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "docs:build": "pnpm -C docs run build",
    "docs:check": "vitest run docs/.vitepress/config/documentation.test.ts",
    "docs:dev": "pnpm -C docs run dev",
    "docs:sync": "node --experimental-strip-types scripts/sync-docs.ts",
    "docs:typecheck": "vue-tsc --noEmit -p docs/tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s format:check lint typecheck docs:typecheck test build test:package",
    "release:version": "bumpp",
    "test": "vitest",
    "test:package": "node --test tests/package/package.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "vue": ">=3.5.42 <4",
    "vue-eslint-parser": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "dependencies": {
    "@ntnyq/utils": "^0.26.0",
    "@typescript-eslint/scope-manager": "^8.72.2",
    "@typescript-eslint/utils": "^8.72.2",
    "natural-orderby": "^5.0.0",
    "uncase": "^0.3.0"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.30",
    "@ntnyq/tsconfig": "^3.1.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "@vue/compiler-sfc": "^3.5.45",
    "bumpp": "^12.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-typegen": "^2.3.2",
    "eslint-vitest-rule-tester": "^3.2.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.78.0",
    "prettier": "3.10.1",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-eslint-parser": "^10.4.2",
    "vue-minimum": "workspace:*",
    "vue-tsc": "^3.3.14"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,vue,md,yml,yaml,json,toml}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
